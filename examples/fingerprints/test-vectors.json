  "relationship_checks": [
    {
      "id": "RC-01-pipe-vs-escaped-pipe-unambiguous",
      "description": "Requirement 16: PV-10a (literal pipe) and PV-10b (escaped pipe) must not collide.",
      "profile": "a11y/pattern/v1",
      "input_a": {
        "target": { "scope_type": "repository", "scope_id": "https://github.com/example/product" },
        "rule": { "namespace": "axe-core", "id": "color-contrast" },
        "locator": { "type": "css", "normalization_profile": "a11y/css-locator/v1", "value": "a|b" },
        "state_key": null
      },
      "input_b": {
        "target": { "scope_type": "repository", "scope_id": "https://github.com/example/product" },
        "rule": { "namespace": "axe-core", "id": "color-contrast" },
        "locator": { "type": "css", "normalization_profile": "a11y/css-locator/v1", "value": "a\\|b" },
        "state_key": null
      },
      "expect": "different"
    },
    {
      "id": "RC-02-route-independent-of-pattern",
      "description": "Requirement 8: two occurrence inputs differing only in location.key still embed and produce comparable pattern-level identity (checked at the pattern layer directly, using the same pattern input twice under key reordering).",
      "profile": "a11y/pattern/v1",
      "input_a": {
        "target": { "scope_type": "repository", "scope_id": "https://github.com/example/product" },
        "rule": { "namespace": "axe-core", "id": "color-contrast" },
        "locator": { "type": "css", "normalization_profile": "a11y/css-locator/v1", "value": "#edit-submit" },
        "state_key": null
      },
      "input_b": {
        "locator": { "type": "css", "normalization_profile": "a11y/css-locator/v1", "value": "#edit-submit" },
        "state_key": null,
        "target": { "scope_type": "repository", "scope_id": "https://github.com/example/product" },
        "rule": { "namespace": "axe-core", "id": "color-contrast" }
      },
      "expect": "same"
    },
    {
      "id": "RC-03-excluded-scan-date-has-no-input-slot",
      "description": "Requirements 12 and 3 (target scoping is identity-bearing, ad hoc fields are not): a pattern input has no field for scan date, so two conforming inputs that differ only in when the underlying scan ran are structurally identical once mapped onto the contract.",
      "profile": "a11y/pattern/v1",
      "input_a": {
        "target": { "scope_type": "repository", "scope_id": "https://github.com/example/product" },
        "rule": { "namespace": "axe-core", "id": "color-contrast" },
        "locator": { "type": "css", "normalization_profile": "a11y/css-locator/v1", "value": "#edit-submit" },
        "state_key": null
