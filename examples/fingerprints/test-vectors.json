      "expected_fingerprint": "0b3ff8a82f0f6065c5e5670ba1ac6c33a8233834000e7aae7d4946c915077e7f"
    },
    {
      "id": "PV-12-missing-required-field",
      "description": "Requirement 18: an omitted required field (state_key) is a validation error, not silently treated as equivalent to an explicit null. See PV-01 for the explicit-null baseline.",
      "input": {
        "target": { "scope_type": "repository", "scope_id": "https://github.com/example/product" },
        "rule": { "namespace": "axe-core", "id": "color-contrast" },
        "locator": { "type": "css", "normalization_profile": "a11y/css-locator/v1", "value": "#edit-submit" }
      },
      "expect_error": "missing_required_field"
    }
