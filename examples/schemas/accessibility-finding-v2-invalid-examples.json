        "description": { "summary": "This record is intentionally invalid." },
        "affected_people": [],
        "tracking": {
          "fingerprints": {
            "a11y/pattern/v1": {
              "algorithm": "sha-256",
              "value": "57869bae817f"
            }
          }
        }
      }
